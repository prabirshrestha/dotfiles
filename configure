#!/usr/bin/env sh
set -e

# Resolve repository configs even when invoked from another directory.
cd "$(dirname "$0")"

if [ -z "${MISE_ENV:-}" ]; then
    case "$(uname -s)" in
    Darwin*) MISE_ENV=macos;;
    Linux*) MISE_ENV=linux;;
    CYGWIN*|MSYS*|MINGW*|Windows*) MISE_ENV=windows;;
    esac
    export MISE_ENV
fi

MISE_TRUSTED_CONFIG_PATHS="$PWD" mise bootstrap --yes -v
MISE_TRUSTED_CONFIG_PATHS="$PWD" mise exec -- dotter -vv "$@"
MISE_TRUSTED_CONFIG_PATHS="$PWD" mise install
