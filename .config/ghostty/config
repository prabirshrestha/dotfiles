command = /opt/homebrew/bin/fish --login --interactive

window-inherit-working-directory = true

# Preserve native terminal interactions while TUIs and multiplexers have mouse
# reporting on. Use Shift-drag for selection and Shift-Command-click for links.
mouse-shift-capture = never

link-url = true

# Match common terminal behavior: selection stays highlighted until explicitly
# copied with the terminal copy shortcut.
copy-on-select = false

keybind = ctrl+shift+comma=reload_config

keybind = ctrl+a>n=new_window
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>-=new_split:down
keybind = ctrl+a>\=new_split:right
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>l=goto_split:right
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>z=toggle_split_zoom
keybind = ctrl+a>x=close_surface

keybind = shift+enter=text:\n

keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+a=select_all
