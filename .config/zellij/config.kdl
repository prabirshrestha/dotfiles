// Use Zellij like tmux: press Ctrl-b, then a command key.
keybinds {
    tmux {
        // Press Ctrl-b twice to send Ctrl-b to the focused application.
        bind "Ctrl b" { Write 2; SwitchToMode "Normal"; }

        // Match the custom pane bindings in ~/.tmux.conf.
        bind "\\" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "H" { Resize "Increase Left"; SwitchToMode "Normal"; }
        bind "J" { Resize "Increase Down"; SwitchToMode "Normal"; }
        bind "K" { Resize "Increase Up"; SwitchToMode "Normal"; }
        bind "L" { Resize "Increase Right"; SwitchToMode "Normal"; }
        bind "T" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "Esc" { SwitchToMode "Scroll"; }

        // Zellij tabs are the equivalent of tmux windows.
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "Ctrl h" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "Ctrl l" { GoToNextTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
    }

    // Preserve the rest of Zellij's default bindings while making Ctrl-b the
    // tmux-style prefix from every interactive mode except locked mode.
    shared_except "tmux" "locked" {
        bind "Ctrl b" { SwitchToMode "Tmux"; }
    }
}

// Match the quiet graphite palette used by tmux and cmux.
themes {
    graphite {
        text_unselected {
            base "#74777c"
            background "#0f1217"
            emphasis_0 "#aeb4be"
            emphasis_1 "#5aa7ff"
            emphasis_2 "#5aa7ff"
            emphasis_3 "#eef1f5"
        }
        text_selected {
            base "#eef1f5"
            background "#22262d"
            emphasis_0 "#aeb4be"
            emphasis_1 "#5aa7ff"
            emphasis_2 "#5aa7ff"
            emphasis_3 "#eef1f5"
        }
        ribbon_unselected {
            base "#74777c"
            background "#0f1217"
            emphasis_0 "#aeb4be"
            emphasis_1 "#22262d"
            emphasis_2 "#5aa7ff"
            emphasis_3 "#eef1f5"
        }
        ribbon_selected {
            base "#0f1217"
            background "#5aa7ff"
            emphasis_0 "#eef1f5"
            emphasis_1 "#aeb4be"
            emphasis_2 "#22262d"
            emphasis_3 "#eef1f5"
        }
        table_title {
            base "#5aa7ff"
            background "#0f1217"
            emphasis_0 "#eef1f5"
            emphasis_1 "#aeb4be"
            emphasis_2 "#5aa7ff"
            emphasis_3 "#74777c"
        }
        table_cell_unselected {
            base "#aeb4be"
            background "#0f1217"
            emphasis_0 "#eef1f5"
            emphasis_1 "#74777c"
            emphasis_2 "#5aa7ff"
            emphasis_3 "#aeb4be"
        }
        table_cell_selected {
            base "#eef1f5"
            background "#22262d"
            emphasis_0 "#5aa7ff"
            emphasis_1 "#aeb4be"
            emphasis_2 "#eef1f5"
            emphasis_3 "#74777c"
        }
        list_unselected {
            base "#aeb4be"
            background "#0f1217"
            emphasis_0 "#eef1f5"
            emphasis_1 "#74777c"
            emphasis_2 "#5aa7ff"
            emphasis_3 "#aeb4be"
        }
        list_selected {
            base "#eef1f5"
            background "#22262d"
            emphasis_0 "#5aa7ff"
            emphasis_1 "#aeb4be"
            emphasis_2 "#eef1f5"
            emphasis_3 "#74777c"
        }
        frame_unselected {
            base "#262b33"
            background "#0f1217"
            emphasis_0 "#74777c"
            emphasis_1 "#262b33"
            emphasis_2 "#aeb4be"
            emphasis_3 "#22262d"
        }
        frame_selected {
            base "#5aa7ff"
            background "#0f1217"
            emphasis_0 "#eef1f5"
            emphasis_1 "#aeb4be"
            emphasis_2 "#5aa7ff"
            emphasis_3 "#22262d"
        }
        frame_highlight {
            base "#5aa7ff"
            background "#0f1217"
            emphasis_0 "#eef1f5"
            emphasis_1 "#5aa7ff"
            emphasis_2 "#aeb4be"
            emphasis_3 "#5aa7ff"
        }
        exit_code_success {
            base "#5aa7ff"
            background "#0f1217"
            emphasis_0 "#aeb4be"
            emphasis_1 "#22262d"
            emphasis_2 "#eef1f5"
            emphasis_3 "#74777c"
        }
        exit_code_error {
            base "#ff6b6b"
            background "#0f1217"
            emphasis_0 "#d6b55f"
            emphasis_1 "#22262d"
            emphasis_2 "#aeb4be"
            emphasis_3 "#74777c"
        }
        multiplayer_user_colors {
            player_1 "#5aa7ff"
            player_2 "#a78bfa"
            player_3 "#7dcfff"
            player_4 "#d6b55f"
            player_5 "#ff6b6b"
            player_6 "#aeb4be"
            player_7 "#5aa7ff"
            player_8 "#a78bfa"
            player_9 "#7dcfff"
            player_10 "#d6b55f"
        }
    }
}

default_mode "normal"
osc8_hyperlinks true
show_startup_tips false
theme "graphite"
