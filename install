#!/usr/bin/env sh
set -e

# On Windows, keep using the BusyBox executable that started this bootstrap
# until Scoop has installed its own copy.
DOTFILES_BUSYBOX="${1:-busybox.exe}"
export DOTFILES_BUSYBOX

arch="$(uname -m)"
unameOut="$(uname -s)"
case "${unameOut}" in
  Linux*)     platform=linux;;
  Darwin*)    platform=mac;;
  CYGWIN*)    platform=cygwin;;
  MSYS*)      platform=windows;;
  MINGW*)     platform=mingw;;
  Windows*|Window*) platform=windows;;
  *)          platform="UNKNOWN:${unameOut}"
esac

if [ "$platform" = "mac" ]; then
  echo "Detected MacOS"

  export HOMEBREW_NO_ENV_HINTS=1
  export HOMEBREW_NO_ANALYTICS=1
  export HOMEBREW_NO_ASK=1

  if ! command -v brew > /dev/null 2>&1; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi

  if ! command -v mise > /dev/null 2>&1; then
    brew install mise
  fi

  mise bootstrap --yes

  brew install \
    axodotdev/tap/cargo-dist \
    cmux \
    deskpad \
    fd \
    fisher \
    fnm \
    gh \
    git-credential-manager \
    git-gui \
    git-lfs \
    herdr \
    hyperfine \
    jj \
    jq \
    just \
    derailed/k9s/k9s \
    keycastr \
    kind \
    kluctl/tap/kluctl \
    kubectl \
    kubectx \
    kunobi-ninja/kunobi/kache \
    llama.cpp \
    localai \
    lnav \
    mole \
    mosh \
    nono \
    opensuperwhisper \
    poppler \
    portaudio \
    pnpm \
    ripgrep \
    rmux \
    rustup \
    sops \
    television \
    tig \
    tmux \
    tree \
    trzsz-ssh \
    tsshd \
    tuicr \
    utm \
    uv \
    vlc \
    wezterm \
    wget \
    max-sixty/worktrunk/wt \
    yq \
    zellij \
    zoxide \
    ;

  brew install dotenvx/brew/dotenvx
  brew trust maddada/tap
  brew install --cask \
    claude-code@latest \
    codex \
    chatgpt \
    docker \
    freelens \
    maddada/tap/ghostex \
    ghostty \
    lm-studio \
    spokenly \
  ;

  if command -v rustup > /dev/null 2>&1; then
    rustup component add rust-src rust-analyzer
  fi

  if command -v wt > /dev/null 2>&1; then
    wt config shell install
  fi


  brew install --cask \
    disk-inventory-x \
    keepassxc \
    zed@preview \
  ;

  brew install eugene1g/safehouse/agent-safehouse

  case "$(scutil --get ComputerName)" in
  *Work*)
    brew install \
      gettext \
      azure-data-studio \
      azure-cli \
      ;
    brew install --cask yubico-yubikey-manager
    ;;
  *)
    brew install --cask tailscale-app
    brew install hermes-agent
    ;;
  esac
elif [ "$platform" = "linux" ]; then
  echo "Linux Detected"
  if [ -f "/etc/arch-release" ]; then
    echo "ArchLinux detected"

    if [ "$EUID" -eq 0 ]; then
      read -p "Enter non-root username: " USERNAME
      if id "$USERNAME" >/dev/null 2>&1; then
        echo 'user found'
      else
        useradd -m -G wheel "$USERNAME"
        passwd "$USERNAME"
      fi
      pacman -Sy sudo --noconfirm
      sed -i '/%wheel ALL=(ALL:ALL) ALL/s/^#//' /etc/sudoers
    else
      USERNAME=$(whoami)
    fi
    if ! command -v paru > /dev/null 2>&1; then
      sudo pacman -S --needed --noconfirm base-devel git
      sudo rm -rf /tmp/paru-bin
      sudo -u "$USERNAME" git clone https://aur.archlinux.org/paru-bin.git /tmp/paru-bin
      oldpwd="$(pwd)"
      cd /tmp/paru-bin
      sudo -u "$USERNAME" makepkg -si --noconfirm
      cd "$oldpwd"
      rm -rf /tmp/paru-bin
    fi
    if ! command -v mise > /dev/null 2>&1; then
      sudo pacman -Sy --needed --noconfirm mise
    fi
    sudo -u "$USERNAME" paru -Sy --noconfirm \
      bspwm \
      curl \
      chromium \
      git \
      google-chrome \
      linux-headers \
      mosh \
      picom \
      polybar \
      rofi \
      sxhkd \
      tmux \
      unzip \
      wezterm \
      xsel
    sudo -u "$USERNAME" paru -Sy --noconfirm xorg xfce4 sddm
    sudo -u "$USERNAME" systemctl enable sddm
    mise bootstrap --yes
  elif grep -Eiq 'debian|buntu|mint' /etc/*release; then
   echo "Debian based distro detected"
   sudo apt-get update
   if ! command -v mise > /dev/null 2>&1; then
     sudo apt-get install -y ca-certificates extrepo
     sudo extrepo enable mise
     sudo apt-get update
     sudo apt-get install -y mise
   fi
   sudo apt-get install -y \
     build-essential \
     curl \
     git \
     mosh \
     tmux
   mise bootstrap --yes
  else
    echo "Unsupported Linux Distro"
    exit 1
  fi

elif [ "$platform" = "windows" ] || [ "$platform" = "cygwin" ] || [ "$platform" = "mingw" ]; then
  echo "Windows Detected"
  # Enabling Windows sudo requires an elevated terminal. Configure it directly
  # when this shell is elevated; otherwise leave the existing setting alone.
  if ! sudo.exe config > /dev/null 2>&1; then
    if ! sudo.exe config --enable normal; then
      echo "Windows sudo is disabled; enable it from an Administrator terminal with:"
      echo "  sudo.exe config --enable normal"
    fi
  fi

  # Enable Windows Developer Mode (required for symlinks without elevation)
  if ! reg.exe query "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock" /v AllowDevelopmentWithoutDevLicense 2>/dev/null | grep -q "0x1"; then
    sudo.exe reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock" /t REG_DWORD /f /v AllowDevelopmentWithoutDevLicense /d 1
  fi

  # Add ~/.local/bin and dotfiles bin-windows to the persistent user PATH.
  user_path="$(reg.exe query 'HKCU\Environment' /v Path 2>/dev/null | tr -d '\r' | sed -n 's/^[[:space:]]*Path[[:space:]]*REG_[A-Z_]*[[:space:]]*//p')"
  user_path_key="$(printf '%s' ";$user_path;" | tr '\\' '/' | tr '[:upper:]' '[:lower:]')"
  for dir in "$HOME/.local/bin" "$HOME/.dotfiles/bin-windows"; do
    dir_key="$(printf '%s' "$dir" | tr '\\' '/' | tr '[:upper:]' '[:lower:]')"
    case "$user_path_key" in
      *";$dir_key;"*) echo "$dir already in user PATH" ;;
      *)
        user_path="${user_path:+$user_path;}$dir"
        user_path_key="$user_path_key$dir_key;"
        reg.exe add 'HKCU\Environment' /v Path /t REG_EXPAND_SZ /d "$user_path" /f > /dev/null
        echo "Added $dir to user PATH"
        ;;
    esac
  done

  # Install the latest sshdt Windows release into the user-local bin directory.
  sshdt_release_json="$(curl.exe -fsSL https://api.github.com/repos/prabirshrestha/sshdt/releases/latest)"
  sshdt_asset_url="$(printf '%s\n' "$sshdt_release_json" | sed -n 's/.*"browser_download_url": "\([^"]*x86_64-pc-windows-msvc.zip\)".*/\1/p' | head -n 1)"
  if [ -z "$sshdt_asset_url" ]; then
    echo "Unable to find the latest sshdt Windows release asset." >&2
    exit 1
  fi
  sshdt_asset_name="${sshdt_asset_url##*/}"
  sshdt_tmp="${TEMP:-$HOME/AppData/Local/Temp}/sshdt-install-$$"
  mkdir -p "$HOME/.local/bin" "$sshdt_tmp"
  echo "Installing sshdt into $HOME/.local/bin"
  curl.exe -fsSL "$sshdt_asset_url" -o "$sshdt_tmp/$sshdt_asset_name"
  unzip -qo "$sshdt_tmp/$sshdt_asset_name" -d "$sshdt_tmp/extracted"
  cp "$sshdt_tmp/extracted/sshdt.exe" "$HOME/.local/bin/sshdt.exe"
  rm -rf "$sshdt_tmp"

  # WinGet is the Windows bootstrap; Mise owns the remaining package setup.
  if ! cmd.exe /c where mise > /dev/null 2>&1; then
    winget.exe install --id jdx.mise --exact --source winget --scope user \
      --accept-package-agreements --accept-source-agreements \
      --disable-interactivity --no-upgrade
  fi
  mise_bin="$(cmd.exe /d /c where mise.exe 2>/dev/null | tr -d '\r' | head -n 1)"
  if [ -n "$mise_bin" ]; then
    PATH="$(dirname "$mise_bin");$PATH"
    export PATH
  elif [ -x "$LOCALAPPDATA/Microsoft/WinGet/Links/mise.exe" ]; then
    PATH="$LOCALAPPDATA/Microsoft/WinGet/Links;$PATH"
    export PATH
  fi
fi

if command -v bun > /dev/null 2>&1; then
  if ! command -v rift > /dev/null 2>&1; then
    bun add -g rift-snapshot
  fi
fi

# Minimum release age: only install package versions older than 7 days
# (mitigates supply-chain attacks via freshly-published malicious versions)
if command -v npm > /dev/null 2>&1; then
  if ! npm config set min-release-age=7; then
    if npm install -g npm@latest; then
      npm config set min-release-age=7 || echo "Skipping npm min-release-age; unsupported by current npm."
    else
      echo "Skipping npm min-release-age; npm update failed."
    fi
  fi
fi
if command -v pnpm > /dev/null 2>&1; then
  pnpm config set minimumReleaseAge 10080
fi
if command -v yarn > /dev/null 2>&1; then
  yarn_major="$(yarn --version | cut -d. -f1)"
  if [ "$yarn_major" -ge 2 ] 2>/dev/null; then
    yarn config set -H npmMinimalAgeGate "168h"
  else
    echo "Skipping Yarn minimum age gate; Yarn Classic does not support it."
  fi
fi
if command -v bun > /dev/null 2>&1; then
  if ! grep -q "minimumReleaseAge" "$HOME/.bunfig.toml" 2>/dev/null; then
    printf '\n[install]\nminimumReleaseAge = 604800\n' >> "$HOME/.bunfig.toml"
  fi
fi

dotfiles_dir="$HOME/.dotfiles"

if command -v git > /dev/null 2>&1; then
  if [ ! -d "$dotfiles_dir/.git" ]; then
    echo "Cloning dotfiles into $dotfiles_dir"
    git clone --recurse-submodules https://github.com/prabirshrestha/dotfiles.git "$dotfiles_dir"
  else
    echo "Updating dotfiles in $dotfiles_dir"
    git -C "$dotfiles_dir" pull --ff-only --recurse-submodules
  fi
else
  echo "Skipping dotfiles clone; git is not installed."
fi

if [ -x "$dotfiles_dir/configure" ]; then
  echo "Applying dotfiles from $dotfiles_dir"
  oldpwd="$(pwd)"
  cd "$dotfiles_dir"
  ./configure
  cd "$oldpwd"
else
  echo "Skipping dotfiles apply; $dotfiles_dir/configure was not found or is not executable."
fi

if command -v cargo > /dev/null 2>&1 && ! command -v cargo-clean-all > /dev/null 2>&1; then
  cargo install cargo-clean-all
fi

if [ "$platform" = "windows" ] || [ "$platform" = "cygwin" ] || [ "$platform" = "mingw" ]; then
  if command -v clink > /dev/null 2>&1 && [ -d "$dotfiles_dir/clink" ]; then
    clink_profile="${LOCALAPPDATA:-$HOME/AppData/Local}/clink"
    echo "Configuring Clink profile in $clink_profile"
    mkdir -p "$clink_profile"
    cp "$dotfiles_dir"/clink/*.lua "$clink_profile"/
    cp "$dotfiles_dir"/clink/clink_settings "$clink_profile"/
    clink autorun install -- --profile "$clink_profile"
  fi
fi
